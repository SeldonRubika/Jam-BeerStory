theme_override_font_sizes/mono_font_size = 38
text = "Permet de mixer vos boissons et vos ingrédients pour faire des nouvelles boissons ou modifier vos boissons.
Boisson + Sucre --> Augmente le sucre de la boisson
Boisson + Alcool Pur --> Augmente le degré de la boisson
Boisson + Eau --> Réduit le degré de la boisson
Boisson + Asucrite --> Réduit le sucre de la boisson
Boisson + Boisson --> Cocktail (trop de mixage donne une boisson imbuvable)
Alcoor Pur + Ingrédient --> Ingrédient Macéré
Ingrédient Macéré + Sucre --> Liqueur"
scroll_active = false
