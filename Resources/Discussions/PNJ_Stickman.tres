[resource]
script = ExtResource("1_rjh0q")
discussion_name = "Dialogues Dragon"
characters = Array[String](["Dragon"])
dialogs = Array[Array]([["Dragon", "Humain. Sers moi donc ta bière la plus forte. J'ai entendu dire que cette boisson était particulièrement appréciée dans ce royaume. JE DÉSIRE Y GOÛTER."], ["Dragon", "N'ait pas peur, fragile être humain. Je suis à la recherche de la boisson parfaite, une eau-de-vie si sucrée  que je pourrais la manger. ALLEZ DÉPÊCHE-TOI !"], ["Dragon", "Ce n'est pas trop tôt ! Fais plus vite la prochaine fois !"], ["Dragon", "ARRGHH NE M'OBLIGE PAS À DÉTRUIRE CETTE TAVERNE !"]])
required_type = null
