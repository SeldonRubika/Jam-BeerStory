[gd_resource type="Resource" script_class="DiscussionBase" format=3 uid="uid://d4fqxl4jpr3bj"]

[ext_resource type="Script" uid="uid://cbbee7mqifuky" path="res://Resources/Discussions/AADiscussionsBase.gd" id="1_uf1i4"]

[resource]
script = ExtResource("1_uf1i4")
dialogs = Array[Array]([["Tutoriel", "Bienvenue dans votre taverne ! Ici, vous préparerez vos meilleures boissons pour les servir aux voyageurs et aventuriers qui franchiront vos portes !"], ["Tutoriel", "Votre objectif est de vendre toujours plus de boissons pour améliorer vos finances, et ainsi éviter la faillite à votre établissement."], ["Tutoriel", "En ouvrant la page \"Stockage\", vous retrouvez tout vos ingrédients et vos boissons, prêts à être utilisés pour vos breuvages. En cliquant sur l'un d'entre eux, vous pouvez consulter sa description et les statistiques qu'il apporte à votre boisson."], ["Tutoriel", "Degré d'alcool, amertume, sucre, buvabilité, ou encore des caractéristique comme \"fruité\" ou \"pétillant\". Vos clients auront des demandes bien particulières, et c'est à vous de concevoir une boisson qui se rapproche le plus de leurs goûts"], ["Tutoriel", "Afin de confectionner votre alcool, il existe 4 pages essentielles: \"broyage\", \"fermentation\", \"distillation\" et \"combinaison\". N'hésitez pas à les explorer pour obtenir de nouvelles boissons !"], ["Tutoriel", "Par exemple: en broyant du raisin, vous obtiendrez du jus de raisin. En faisant fermenter ce dernier, vous obtiendrez du vin. Les combinaisons sont variées, mais attention à ne pas trop transformer une boisson si vous voulez qu'elle soit buvable."], ["Tutoriel", "Sur la page \"Service\",  vous pourrez prendre des commandes et servir des boissons. Les clients ne vous demanderont jamais un degré d'alcool précis, par exemple. C'est à vous d'en déduire la boisson à servir selon leurs goûts."], ["Tutoriel", "Vous pouvez voir à droite l'argent que vous possédez, ainsi que le jour actuel. Selon les jours de la semaine, vous passerez d'une phase de service à une phase d'achat."], ["Tutoriel", "Lors des phases d'achat, il est possible d'acheter de nouveaux ingrédients à différents marchands. Il est aussi possible de cultiver ses propres ingrédients en accédant à la page \"Jardinage\"."], ["Tutoriel", "Attention ! Tous les dimanches, à la fin de la journée, vous devrez payer votre loyer. Si vous n'avez pas assez de gold, votre taverne fera faillite et la partie prendra fin."], ["Tutoriel", "Bonne chance, cher tavernier !"]])
required_type = null
metadata/_custom_type_script = "uid://cbbee7mqifuky"
